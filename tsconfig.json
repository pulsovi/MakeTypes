{
    "compilerOptions": {
        "module": "nodenext",
        "types": ["node"],
        "noUnusedLocals": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "lib",
        "skipLibCheck": true,
    },
    "include": ["lib/**/*"],
    "exclude": ["dist", "test", "node_modules"],
}